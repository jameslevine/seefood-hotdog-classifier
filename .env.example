# Local development uses the standard AWS_* names.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
DDB_TABLE=seefood-classifications
S3_BUCKET=seefood-thumbnails-563146874500-eu-west-2

# On Vercel, AWS_* / AWS_REGION are reserved env-var names and cannot be set.
# Use the APP_AWS_* equivalents instead — lib/aws.ts reads these first:
#   APP_AWS_REGION=eu-west-2
#   APP_AWS_ACCESS_KEY_ID=your-access-key-id
#   APP_AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Magnific (Mystic) API key — used ONLY by scripts/generate-marketing-images.mjs
# to generate marketing imagery offline. Never shipped to the client or Vercel.
MAGNIFIC_API_KEY=your-magnific-api-key
LEADS_TABLE=seefood-leads
APIKEYS_TABLE=seefood-apikeys
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-app-client-id
COGNITO_REGION=eu-west-2
SESSION_SECRET=a-long-random-secret-for-signing-cookies
